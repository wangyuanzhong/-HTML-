{
  "project": "vibe-html",
  "type": "static-html",
  "languageStack": ["html5", "css3", "javascript-es5"],
  "packageManagers": [],
  "requiredRuntime": [
    {
      "name": "web-browser",
      "reason": "Open template-*.html; ES5-friendly script, no Node required to preview"
    }
  ],
  "optionalTools": [
    {
      "name": "apache-ant",
      "minVersion": "1.10",
      "reason": "build.xml: dist, clean, verify-layout, info",
      "verifyCommand": "ant -version"
    },
    {
      "name": "static-http-server",
      "examples": [
        "npx --yes serve competitive-analysis-templates",
        "python -m http.server"
      ],
      "reason": "If file:// blocks features; not shipped with repo"
    },
    {
      "name": "python3-openpyxl",
      "reason": "Regenerate demo data/matrix-*.xlsx via tools/build-matrix-xlsx.py",
      "verifyCommand": "python -c \"import openpyxl\""
    }
  ],
  "sourceRoots": ["competitive-analysis-templates"],
  "entryPoints": [
    "competitive-analysis-templates/template-tech.html",
    "competitive-analysis-templates/template-macaron.html",
    "competitive-analysis-templates/template-minimal.html"
  ],
  "build": {
    "system": "apache-ant",
    "file": "build.xml",
    "artifactDirectory": "build/dist",
    "defaultTarget": "info",
    "commands": {
      "package": "ant dist",
      "clean": "ant clean",
      "verify": "ant verify-layout"
    }
  },
  "encoding": "UTF-8",
  "documentation": {
    "dependencies": "DEPENDENCIES.md",
    "templates": "competitive-analysis-templates/README.md"
  },
  "assumptions": [
    "No npm install unless a package.json is added later",
    "Demo content may reference external image URLs; replace for strict offline"
  ]
}
